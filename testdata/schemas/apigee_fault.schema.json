{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apigee policy fault body (VerifyAPIKey, OAuthV2, Quota, SpikeArrest...)",
  "type": "object",
  "required": ["fault"],
  "properties": {
    "fault": {
      "type": "object",
      "required": ["faultstring", "detail"],
      "properties": {
        "faultstring": {"type": "string", "minLength": 1},
        "detail": {
          "type": "object",
          "required": ["errorcode"],
          "properties": {"errorcode": {"type": "string", "pattern": "^[A-Za-z0-9_.]+$"}}
        }
      }
    }
  }
}
